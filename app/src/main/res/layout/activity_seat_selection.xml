<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="20dp"
    android:background="#121212">

    <TextView
        android:id="@+id/perdeTxt"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="P E R D E  /  S C R E E N"
        android:textColor="#FFFFFF"
        android:background="#333333"
        android:gravity="center"
        android:textStyle="bold"
        android:layout_marginBottom="40dp"/>

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="3"
        android:layout_weight="1"
        android:gravity="center">

        <Button android:text="A1" android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="5dp" android:backgroundTint="#4CAF50" android:padding="0dp"/>
        <Button android:text="A2" android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="5dp" android:backgroundTint="#4CAF50" android:padding="0dp"/>
        <Button android:text="A3" android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="5dp" android:backgroundTint="#4CAF50" android:padding="0dp"/>
        <Button android:text="A4" android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="5dp" android:backgroundTint="#4CAF50" android:padding="0dp"/>

        <Button android:text="B1" android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="5dp" android:backgroundTint="#4CAF50" android:padding="0dp"/>
        <Button android:text="B2" android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="5dp" android:backgroundTint="#4CAF50" android:padding="0dp"/>
        <Button android:text="B3" android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="5dp" android:backgroundTint="#4CAF50" android:padding="0dp"/>
        <Button android:text="B4" android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="5dp" android:backgroundTint="#4CAF50" android:padding="0dp"/>

        <Button android:text="C1" android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="5dp" android:backgroundTint="#4CAF50" android:padding="0dp"/>
        <Button android:text="C2" android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="5dp" android:backgroundTint="#4CAF50" android:padding="0dp"/>
        <Button android:text="C3" android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="5dp" android:backgroundTint="#4CAF50" android:padding="0dp"/>
        <Button android:text="C4" android:layout_width="55dp" android:layout_height="55dp" android:layout_margin="5dp" android:backgroundTint="#4CAF50" android:padding="0dp"/>
    </GridLayout>

    <Button
        android:id="@+id/btnKoltukOnayla"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Koltukları Onayla ve İlerle"
        android:textSize="16sp"
        android:backgroundTint="#FF9800"
        android:layout_marginTop="20dp"/>
</LinearLayout>