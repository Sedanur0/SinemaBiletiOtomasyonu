<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="30dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✔"
        android:textColor="#4CAF50"
        android:textSize="80sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BİLETİNİZ HAZIR!"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="30dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Film: Seçilen Film\nTarih: 20 Mayıs 2026\nSaat: 20:00\nKoltuk: A1, A2"
        android:textColor="#BBBBBB"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginBottom="40dp"/>

    <View
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="40dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Girişte bu QR kodu okutunuz."
        android:textColor="#888888"
        android:textSize="14sp"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btnAnaSayfa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ana Sayfaya Dön"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/txtBiletDetay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Yükleniyor..."
        android:textColor="#BBBBBB"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginBottom="40dp"/>

</LinearLayout>